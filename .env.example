# --- Hugging Face (optional) ---
# Token for the Inference Providers API. Needs an account WITH inference
# credits enabled; a token without them returns HTTP 402.
# Get one at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# --- Gemini (optional) ---
# Used by the web UI's "Gemini" answer source (no extra dependency needed).
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# --- Ollama (optional) ---
# Only override this if your Ollama server isn't on the default port.
# The web UI's "Ollama" source lists whatever models `ollama list` shows.
# OLLAMA_BASE_URL=http://localhost:11434/v1
